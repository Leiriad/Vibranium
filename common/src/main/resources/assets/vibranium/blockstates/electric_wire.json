{
  "multipart": [
    {
      "when": { "facing": "up" },
      "apply": { "model": "vibranium:block/electric_wire_core", "x": 180 }
    },
    {
      "when": { "facing": "up", "north": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "x": 180, "y": 180 }
    },
    {
      "when": { "facing": "up", "east": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "x": 180, "y": 270 }
    },
    {
      "when": { "facing": "up", "south": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "x": 180, "y": 0 }
    },
    {
      "when": { "facing": "up", "west": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "x": 180, "y": 90 }
    },

    {
      "when": { "facing": "down" },
      "apply": { "model": "vibranium:block/electric_wire_core" }
    },
    {
      "when": { "facing": "down", "north": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "y": 0 }
    },
    {
      "when": { "facing": "down", "east": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "y": 90 }
    },
    {
      "when": { "facing": "down", "south": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "y": 180 }
    },
    {
      "when": { "facing": "down", "west": "true" },
      "apply": { "model": "vibranium:block/electric_wire_segment", "y": 270 }
    }
  ]
}